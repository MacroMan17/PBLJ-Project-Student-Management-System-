{
  "info": {
    "name": "Student Management System API",
    "description": "REST API collection for managing student records",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add New Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Alice Johnson\",\n    \"email\": \"alice.johnson@example.com\",\n    \"course\": \"Data Science\",\n    \"age\": 20\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/students",
          "host": ["{{base_url}}"],
          "path": ["api", "students"]
        },
        "description": "Add a new student to the system"
      },
      "response": []
    },
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/students",
          "host": ["{{base_url}}"],
          "path": ["api", "students"]
        },
        "description": "Retrieve all students from the system"
      },
      "response": []
    },
    {
      "name": "Get Student by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/students/1",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "1"]
        },
        "description": "Retrieve a student by their ID"
      },
      "response": []
    },
    {
      "name": "Get Students by Course",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/students/course/Computer%20Science",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "course", "Computer%20Science"]
        },
        "description": "Retrieve all students enrolled in a specific course"
      },
      "response": []
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Alice Smith\",\n    \"email\": \"alice.smith@example.com\",\n    \"course\": \"Machine Learning\",\n    \"age\": 21\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/students/1",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "1"]
        },
        "description": "Update student details"
      },
      "response": []
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/students/1",
          "host": ["{{base_url}}"],
          "path": ["api", "students", "1"]
        },
        "description": "Delete a student from the system"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ]
}
